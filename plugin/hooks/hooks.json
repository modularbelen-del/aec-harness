{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python 3.12 python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python 3.12 python \"${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*revit.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python 3.12 python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool.py\"; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python 3.12 python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*revit.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python 3.12 python \"${CLAUDE_PLUGIN_ROOT}/hooks/post_tool.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
